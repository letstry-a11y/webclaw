# Database - for Docker deployment, use /app/data path (volume-mounted)
DATABASE_URL="file:./dev.db"

# Admin password for /admin/login (required)
ADMIN_PASSWORD="change-me"

# JWT secret for admin session cookie (required, use a long random string)
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-in-production"

# Comma-separated company email domains allowed to self-register
COMPANY_EMAIL_DOMAINS="microport.com"

# Company SMTP service used for registration and password-reset codes
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="medbot@example.com"
SMTP_PASSWORD="change-me"
SMTP_FROM="Medbot AI Community <medbot@example.com>"

# Local development only: set to console to test registration without SMTP.
# Never enable this in production; Next.js production builds ignore this mode.
AUTH_EMAIL_MODE="smtp"

# Set to "true" to auto-seed sample data on first startup (Docker only)
SEED_ON_STARTUP="false"

# Override container port mapping
PORT=3000
