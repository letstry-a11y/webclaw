# Database - for Docker deployment, use /app/data path (volume-mounted)
DATABASE_URL="file:./dev.db"

# Employee accounts require administrator approval. Set the agreed initial password privately.
INITIAL_USER_PASSWORD=""
COMPANY_EMAIL_DOMAINS="microport.com"
PUBLIC_BASE_URL=""

# JWT signing key for account and device sessions
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-in-production"

# Optional read-only credential for a weekly reporting job, e.g. openssl rand -hex 32
MANAGEMENT_REPORT_TOKEN=""

# Set to "true" to auto-seed sample data on first startup (Docker only)
SEED_ON_STARTUP="false"

# Override container port mapping
PORT=3000
