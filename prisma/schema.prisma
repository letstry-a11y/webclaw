generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Post {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  content           String
  excerpt           String
  coverImage        String?
  type              String   @default("blog") // "blog" | "activity"
  category          String   @default("general")
  tags              String   @default("")
  authorName        String   @default("匿名用户")
  authorFingerprint String   @default("")
  isPinned          Boolean  @default(false)
  isFeatured        Boolean  @default(false)
  isPublished       Boolean  @default(true)
  viewCount         Int      @default(0)
  likeCount         Int      @default(0)
  attachments       String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  comments Comment[]
  likes    Like[]

  eventDate     DateTime?
  eventLocation String?
  eventLink     String?

  aiRecruitment AiDemandRequest?
}

model Comment {
  id         String   @id @default(cuid())
  content    String
  authorName String   @default("匿名用户")
  postId     String
  parentId   String?
  createdAt  DateTime @default(now())

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")
}

model Like {
  id          String   @id @default(cuid())
  postId      String
  fingerprint String
  createdAt   DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, fingerprint])
}

model Category {
  id    String  @id @default(cuid())
  name  String  @unique
  slug  String  @unique
  icon  String?
  order Int     @default(0)
}

model AiProject {
  id             String   @id @default(cuid())
  name           String
  subtitle       String   @default("")
  businessImpact String   @default("")
  owner          String   @default("")
  releasePlan    String   @default("")
  status         String   @default("planning")
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  requestId      String?  @unique

  progress AiProjectProgress[]
  actions  AiActionItem[]
  request  AiDemandRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
}

model AiProjectProgress {
  id        String   @id @default(cuid())
  content   String
  projectId String
  createdAt DateTime @default(now())

  project AiProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AiActionItem {
  id          String   @id @default(cuid())
  task        String
  owner       String
  dueDate     DateTime
  isCompleted Boolean  @default(false)
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project AiProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AiPointMember {
  id                 String   @id @default(cuid())
  name               String
  email              String?  @unique
  department         String   @default("")
  level              String   @default("L1")
  historicalPoints   Int      @default(0)
  availablePoints    Int      @default(0)
  completedProjects  Int      @default(0)
  ledProjects        Int      @default(0)
  highImpactProjects Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  entries AiPointEntry[]

  @@index([historicalPoints])
  @@index([level])
}

model AiPointEntry {
  id              String   @id @default(cuid())
  memberId        String
  historicalDelta Int      @default(0)
  availableDelta  Int      @default(0)
  reason          String
  projectName     String   @default("")
  operatorName    String   @default("公开登记")
  createdAt       DateTime @default(now())

  member AiPointMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
}

model AiDemandRequest {
  id                   String    @id @default(cuid())
  title                String
  requesterName        String
  requesterDepartment  String
  requesterEmail       String
  background           String
  currentProblem       String
  desiredFunctions     String
  businessValue        String
  expectedDeliverables String
  targetDate           DateTime?
  availableResources   String    @default("")
  dataSensitivity      String    @default("internal")
  recruitmentRoles     String    @default("")
  weeklyCommitment     String    @default("")
  status               String    @default("pending_review")
  projectLevel         Int?
  basePointPool        Int?
  reviewComment        String    @default("")
  reviewedBy           String    @default("")
  reviewedAt           DateTime?
  recruitmentDeadline  DateTime?
  plannedTeamSize      Int       @default(0)
  warrantyMonths       Int       @default(3)
  activityPostId       String?   @unique
  score                Int?
  effectCoefficient    Float?
  finalPointPool       Int?
  allocationNote       String    @default("")
  pointsApprovedBy     String    @default("")
  pointsApprovedAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  activityPost Post?                      @relation(fields: [activityPostId], references: [id], onDelete: SetNull)
  project      AiProject?
  applications AiProjectApplication[]
  teamMembers  AiProjectTeamMember[]
  allocations  AiProjectPointAllocation[]
  logs         AiWorkflowLog[]

  @@index([status, createdAt])
  @@index([requesterEmail])
}

model AiProjectApplication {
  id                 String   @id @default(cuid())
  requestId          String
  name               String
  department         String
  email              String
  intendedRole       String
  skills             String
  weeklyAvailability String
  statement          String   @default("")
  status             String   @default("pending")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  request    AiDemandRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  teamMember AiProjectTeamMember?

  @@unique([requestId, email])
  @@index([requestId, status])
}

model AiProjectTeamMember {
  id             String   @id @default(cuid())
  requestId      String
  applicationId  String?  @unique
  name           String
  department     String
  email          String
  role           String
  responsibility String   @default("")
  isLead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  request     AiDemandRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  application AiProjectApplication?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  allocation  AiProjectPointAllocation?

  @@unique([requestId, email])
  @@index([requestId, isLead])
}

model AiProjectPointAllocation {
  id             String   @id @default(cuid())
  requestId      String
  teamMemberId   String   @unique
  proposedPoints Int
  issuedPoints   Int      @default(0)
  warrantyPoints Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  request    AiDemandRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  teamMember AiProjectTeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model AiWorkflowLog {
  id        String   @id @default(cuid())
  requestId String
  action    String
  actor     String
  detail    String   @default("")
  createdAt DateTime @default(now())

  request AiDemandRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}
